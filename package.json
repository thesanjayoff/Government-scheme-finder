{
  "name": "government-scheme-finder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate-data",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-data": "tsx scripts/validate-data.ts",
    "validate-data:links": "tsx scripts/validate-data.ts --check-links",
    "eval": "tsx scripts/eval/run-eval.ts",
    "test:e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.1.1",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
